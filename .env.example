FIREBASE_PROJECT_ID=pj-delivery
FIREBASE_WEB_API_KEY=api-key-de-firebase
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/service-account.json
STORE_NAME=PJ Delivery
TZ=America/Argentina/Cordoba
PORT=3000

# Distancia automática de envíos
GOOGLE_MAPS_API_KEY=api-key-exclusiva-de-produccion
STORE_LAT=-27.000000
STORE_LNG=-58.000000
ADDRESS_CONTEXT=Resistencia, Chaco, Argentina
TRAVEL_MODE=DRIVE

# Emuladores opcionales
